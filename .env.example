# ==============================================================================
# SECURE FILE STORAGE & SHARING SYSTEM — CONFIGURATION TEMPLATE
# Project: Final Year BE CSE Project (SJCIT)
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# --- Application Server ---
SERVER_PORT=8080
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080/api

# --- Database (PostgreSQL) ---
# Note: Local Windows PostgreSQL 16 default port on this host is 8450 (or 5432 for standard / Docker Compose)
DB_HOST=localhost
DB_PORT=8450
DB_NAME=securestorage
DB_USERNAME=postgres
DB_PASSWORD=Thar@5573
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
FLYWAY_BASELINE_ON_MIGRATE=true

# --- Security & JWT ---
# Secret must be at least 256 bits (32 bytes) Base64 encoded or HMAC key string
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_MS=604800000
OTP_EXPIRATION_MINUTES=5
MAX_OTP_ATTEMPTS=5

# --- Administrator Bootstrap ---
# Used exclusively during first-time database provisioning or controlled initial setup
ADMIN_EMAIL=admin@example.com
ADMIN_DISPLAY_NAME=System Administrator
ADMIN_INITIAL_PASSWORD=ChangeMeOnFirstLogin!2026

# --- Email & SMTP (Mailpit Local Default) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@securestorage.local
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# --- Google OAuth 2.0 / OpenID Connect ---
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- File Storage & Cryptography ---
# Storage provider: local (default) or s3 (MinIO)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
MAX_FILE_SIZE_BYTES=52428800
CHUNK_SIZE_BYTES=1048576

# --- Optional S3 / MinIO Object Storage ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=secure-files
S3_REGION=us-east-1

# --- Development & Feature Toggles ---
DEV_MODE=true
REQUIRE_LOGIN_MFA=true
ALLOW_DEV_OTP_EXPOSURE=true

